  "name": "Flatcap",
  "description": "Quiet precision — semantic tokens for focused work",
  "defaultTheme": "slate",
  "typography": {
    "font.ui": "\"IBM Plex Sans\", \"Segoe UI\", system-ui, sans-serif",
    "font.dense": "\"IBM Plex Sans Condensed\", \"IBM Plex Sans\", system-ui, sans-serif",
    "font.code": "\"Cascadia Code\", \"Cascadia Code NF\", \"CaskaydiaCove Nerd Font Mono\", ui-monospace, Consolas, monospace",
    "font.literal": "\"Cascadia Mono\", \"Cascadia Mono NF\", \"Cascadia Code\", ui-monospace, Consolas, monospace",
    "font.size.body": "0.9375rem",
    "font.size.control": "0.875rem",
    "font.size.meta": "0.8125rem",
    "font.size.reading": "1rem",
    "font.size.code": "0.9375rem",
    "font.size.heading": "1.125rem",
    "font.size.title": "1.5rem",
    "font.line.body": "1.6",
    "font.line.control": "1.428571",
    "font.line.reading": "1.625",
    "font.line.code": "1.6",
    "font.weight.regular": "400",
    "font.weight.medium": "500",
    "font.weight.semibold": "600"
  },
  "metrics": {
    "space.1": "0.25rem",
    "space.2": "0.5rem",
    "space.3": "0.75rem",
    "space.4": "1rem",
    "space.6": "1.5rem",
    "space.8": "2rem",
    "space.12": "3rem",
    "radius.control": "0.25rem",
    "radius.panel": "0.375rem",
    "radius.dialog": "0.5rem",
    "border.width": "1px",
    "focus.width": "2px",
    "focus.offset": "2px",
    "motion.fast": "120ms",
    "reading.width": "70ch",
    "target.touch": "2.75rem"
  },
  "density": {
    "comfortable": {
      "control.min.height": "2.5rem",
      "row.min.height": "2.75rem",
      "control.padding.inline": "1rem",
      "control.padding.block": "0.5rem",
      "cell.padding": "0.75rem"
    },
    "compact": {
      "control.min.height": "2rem",
      "row.min.height": "2.25rem",
      "control.padding.inline": "0.75rem",
      "control.padding.block": "0.25rem",
      "cell.padding": "0.5rem"
    }
  },
  "elevation": {
    "slate": {
      "shadow.overlay": "0 8px 24px rgb(0 0 0 / 24%)"
    },
    "daylight": {
      "shadow.overlay": "0 8px 24px rgb(25 29 34 / 10%)"
    }
  },
  "branding": {
    "theme": "slate",
    "roles": {
      "tile": "bg.canvas",
      "cap.crown": "accent.fg",
      "cap.band": "cap.band",
      "cap.underside": "cap.underside",
      "wordmark": "accent.fg",
      "descriptor": "text.secondary"
    },
    "variant": "mineral",
    "colors": {
      "cap.band": "#638BAA",
      "cap.underside": "#344D62"
    }
  }
